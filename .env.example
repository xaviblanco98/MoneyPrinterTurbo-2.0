# MoneyPrinterTurbo 2.0 — environment template. Copy to `.env` (ignored by git)
# and fill in real values there. Never commit secrets.

# Runtime
MPT2_ENV=development                 # development | test | production
MPT2_DB_PATH=storage/mpt2/mpt2.sqlite3
MPT2_STORAGE_DIR=storage/mpt2
MPT2_LISTEN_HOST=127.0.0.1
MPT2_LISTEN_PORT=8090
MPT2_LOG_LEVEL=INFO
# Optional shared secret required in the `x-api-key` header. Empty = no auth (local only).
MPT2_API_KEY=

# LLM (Ollama is the free local default; any upstream provider id also works)
MPT2_LLM_PROVIDER=ollama
MPT2_OLLAMA_BASE_URL=http://localhost:11434/v1
MPT2_OLLAMA_MODEL=qwen2.5:7b
# For non-Ollama providers only:
MPT2_LLM_MODEL=
MPT2_LLM_BASE_URL=
MPT2_LLM_API_KEY=

# Stock providers (free tiers). If empty, keys from the upstream config.toml are used.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Job queue
MPT2_JOB_MAX_ATTEMPTS=3
MPT2_JOB_RETRY_BASE_SECONDS=5
MPT2_JOB_STALE_LOCK_SECONDS=900

# Product rules (cannot be relaxed in the MVP)
MPT2_REQUIRE_HUMAN_APPROVAL=true
MPT2_AUTO_PUBLISH=false
