# MoneyPrinterTurbo 2.0 — environment template. Copy to `.env` (ignored by git)
# and fill in real values there. Never commit secrets.

# Runtime
MPT2_ENV=development                 # development | test | production
MPT2_DB_PATH=storage/mpt2/mpt2.sqlite3
MPT2_STORAGE_DIR=storage/mpt2
MPT2_LISTEN_HOST=127.0.0.1
MPT2_LISTEN_PORT=8090
MPT2_LOG_LEVEL=INFO
# Optional shared secret required in the `x-api-key` header. Empty = no auth (local only).
MPT2_API_KEY=

# LLM (Ollama is the free local default; any upstream provider id also works)
MPT2_LLM_PROVIDER=ollama
MPT2_OLLAMA_BASE_URL=http://localhost:11434/v1
MPT2_OLLAMA_MODEL=qwen2.5:7b
# For non-Ollama providers only:
MPT2_LLM_MODEL=
MPT2_LLM_BASE_URL=
MPT2_LLM_API_KEY=

# Stock providers (free tiers). If empty, keys from the upstream config.toml are used.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Anthropic API (official SDK). Get a key at https://platform.claude.com (API credits, not a Claude.ai subscription).
ANTHROPIC_API_KEY=
MPT2_LLM_BACKEND=anthropic            # anthropic | fake (offline tests)
MPT2_MODEL_FAST=claude-haiku-4-5      # classification, extraction, storyboard
MPT2_MODEL_SMART=claude-opus-5        # research plan, dossier, fact-check, angles, script, QC
# Optional per-task overrides (JSON): {"storyboard":"smart"} / {"editorial_qc":"claude-sonnet-5"} / {"script_write":"high"}
MPT2_LLM_TASK_TIERS=
MPT2_LLM_TASK_MODELS=
MPT2_LLM_TASK_EFFORT=
MPT2_LLM_TIMEOUT_SECONDS=180
MPT2_LLM_MAX_RETRIES=3
MPT2_LLM_CACHE_ENABLED=true
# Extra/override prices (USD per million tokens): {"claude-x": {"input": 1, "output": 5}}
MPT2_LLM_PRICING_JSON=
MPT2_USD_TO_EUR=0.92

# Web research (Anthropic web_search tool)
MPT2_WEB_SEARCH_TOOL_VERSION=web_search_20250305
MPT2_WEB_SEARCH_MAX_USES_PER_CALL=3
MPT2_RESEARCH_MAX_SEARCHES_PER_PROJECT=30
MPT2_RESEARCH_MAX_SOURCES=40
MPT2_RESEARCH_MIN_SNIPPET_CHARS=40
MPT2_RESEARCH_DOMAIN_POLICY=prefer    # prefer | restrict (only channel allowed_sources)
MPT2_RESEARCH_USER_COUNTRY=

# Budget safety limits (EUR). Admins can raise/lower them via API/CLI; they can never be removed.
MPT2_BUDGET_WARN_EUR=100
MPT2_BUDGET_MONTHLY_HARD_EUR=1000
MPT2_BUDGET_PROJECT_EUR=30
MPT2_BUDGET_PER_CALL_EUR=2

# Job queue
MPT2_JOB_MAX_ATTEMPTS=3
MPT2_JOB_RETRY_BASE_SECONDS=5
MPT2_JOB_STALE_LOCK_SECONDS=900

# Product rules (cannot be relaxed in the MVP)
MPT2_REQUIRE_HUMAN_APPROVAL=true
MPT2_AUTO_PUBLISH=false
